# Private runtime file: copy outside Git and chmod 0600.
BOT_MODE=image
DISCORD_TOKEN=
DISCORD_OWNER_ID=
IMAGE_API_BASE_URL=https://image-api.example.com/v1
IMAGE_API_KEY=
IMAGE_CA_FILE=
# Optional private CA: IMAGE_CA_FILE=/config/backend-ca.crt
# Both lists are mandatory; empty means startup fails.
IMAGE_GUILD_IDS=
IMAGE_CHANNEL_IDS=
# Optional role restriction: empty allows every member in the permitted salons.
IMAGE_ROLE_IDS=
IMAGE_STATE_DIR=/data/images
IMAGE_QUEUE_LIMIT=5
IMAGE_DAILY_LIMIT=10
IMAGE_RETENTION_HOURS=24
IMAGE_TIMEOUT_SECONDS=1850
# Explicitly enable only for initial registration or command changes.
IMAGE_SYNC_COMMANDS=false
# Combined text + images: change BOT_MODE=both and configure these.
# TEXT_API_BASE_URL=https://text-api.example.com/v1
# TEXT_API_KEY=
# TEXT_CA_FILE=/config/backend-ca.crt
# TEXT_MODEL=your-text-model
# TEXT_GUILD_IDS=
# TEXT_CHANNEL_IDS=
# TEXT_ROLE_IDS=
# TEXT_QUEUE_LIMIT=20
# CONTEXT_STORE_PATH=/data/context.json

# IMAGE_PRESETS_JSON maps user-facing presets to backend model IDs/options.
# Default: {"default":{"model":"default"}}. See docs/Images.md.

# Chat and images run independently. Opt in when resources require serialization.
SERIALIZE_BACKENDS=false

# Publish the exact image API prompt with the final image (default false).
# Optional nonstandard images/progress/{request_id} telemetry; see docs/Images.md.
IMAGE_PROGRESS_ENABLED=false
IMAGE_INCLUDE_PROMPT=false
# Optional conversational image tool: both mode + tool-capable Chat Completions.
IMAGE_TOOLS_ENABLED=false
# Optional mounted UTF-8 visual guidance, kept outside Git.
# IMAGE_PROMPT_GUIDANCE_FILE=/config/image-guidance.txt

# Optional connection-readiness marker for a deployment healthcheck.
# BOT_READY_FILE=/data/bot-ready
